{
  "name": "familyhub",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Family Hub: a private household planner (calendar, lists, meals, recipes, tasks, inventory) on PocketBase.",
  "scripts": {
    "dev": "vite",
    "pb": "node scripts/pb-dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "seed": "node scripts/seed.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:api": "node --test tests/integration/rules.test.mjs",
    "test:push": "node --test tests/integration/push.test.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:api && npm run test:push && npm run e2e"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "pocketbase": "^0.29.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "rrule": "^2.8.1",
    "suncalc": "^2.1.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
