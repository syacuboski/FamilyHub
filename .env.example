# Copy to .env for local development. Nothing secret lives in the front end.

# Public VAPID key for Web Push (the private key lives only on the server, in
# /opt/pocketbase/.env.push). Leave blank to disable push in dev.
VITE_VAPID_PUBLIC_KEY=

# Where the dev/test scripts reach PocketBase.
PB_URL=http://127.0.0.1:8090
